<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:fillViewport="true"
    tools:context=".authentication.SettingActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/transparent"
            android:text="@string/settings"
            android:textAllCaps="false"
            android:textColor="@color/primary_green"
            android:textSize="26sp"
            app:icon="@drawable/ic_back_profile"
            app:iconTint="@color/primary_green"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/profile_card_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/primary_yellow"
            app:cardCornerRadius="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_back_profile">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/image_avatar"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:contentDescription="@string/profile_photo"
                    android:src="@drawable/ic_image"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:src="@tools:sample/avatars" />

                <TextView
                    android:id="@+id/text_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/urbanist_bold"
                    android:maxLines="1"
                    android:text="@string/guest_user"
                    android:textColor="@color/calm_black"
                    android:textSize="21sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/image_avatar"
                    app:layout_constraintTop_toTopOf="@id/image_avatar" />

                <ImageView
                    android:id="@+id/image_email"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="7dp"
                    android:contentDescription="@string/email"
                    android:src="@drawable/ic_email"
                    app:layout_constraintStart_toStartOf="@id/text_name"
                    app:layout_constraintTop_toBottomOf="@id/text_name" />

                <TextView
                    android:id="@+id/text_email"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/urbanist_regular"
                    android:maxLines="1"
                    android:text="@string/not_signed_in"
                    android:textColor="@color/calm_black"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="@id/image_email"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/image_email"
                    app:layout_constraintTop_toTopOf="@id/image_email" />

                <ImageView
                    android:id="@+id/image_date_joined"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="6dp"
                    android:contentDescription="@string/join_date"
                    android:src="@drawable/ic_date"
                    app:layout_constraintStart_toStartOf="@id/image_email"
                    app:layout_constraintTop_toBottomOf="@id/image_email" />

                <TextView
                    android:id="@+id/text_date_joined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/urbanist_regular"
                    android:text="@string/join_date"
                    android:textColor="@color/calm_black"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="@id/image_date_joined"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/image_date_joined"
                    app:layout_constraintTop_toTopOf="@id/image_date_joined" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="@color/primary_green"
                    android:text="@string/edit_profile"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_yellow"
                    android:textSize="15sp"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_edit_profile"
                    app:iconTint="@color/primary_yellow"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/image_avatar" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:id="@+id/divider_guest"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/light_grey"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profile_card_view" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_language"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/tts_language"
            android:textAllCaps="false"
            android:textColor="@color/calm_black"
            android:textSize="16sp"
            app:icon="@drawable/ic_localize"
            app:iconGravity="textStart"
            app:iconTint="@color/primary_green"
            app:layout_constraintEnd_toStartOf="@id/tv_language"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_guest" />

        <TextView
            android:id="@+id/tv_language"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:fontFamily="@font/urbanist_medium"
            android:text="@string/language_indonesian"
            android:textColor="@color/primary_green"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/btn_language"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_language" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset_password"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/reset_password"
            android:textAllCaps="false"
            android:textColor="@color/calm_black"
            android:textSize="16sp"
            app:icon="@drawable/ic_reset_pass"
            app:iconGravity="textStart"
            app:iconTint="@color/primary_green"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_language" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_about_us"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/about_us"
            android:textAllCaps="false"
            android:textColor="@color/calm_black"
            android:textSize="16sp"
            app:icon="@drawable/logo_pemandoo_transparent"
            app:iconGravity="textStart"
            app:iconTint="@color/primary_green"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_reset_password" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/signOutButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/logout"
            android:textAllCaps="false"
            android:textColor="@color/calm_black"
            android:textSize="16sp"
            app:icon="@drawable/ic_logout"
            app:iconGravity="textStart"
            app:iconTint="@color/primary_green"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_about_us" />

        <TextView
            android:id="@+id/text_copyright"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"
            android:fontFamily="@font/urbanist_regular"
            android:text="@string/copyright"
            android:textAlignment="center"
            android:textColor="@color/text_color_grey"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/signOutButton" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
